<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" style="text-decoration: none;">
    <div class="card h-100 hoverable">
      <div class="card-body d-flex flex-column" style="padding: 1.25rem;">
        <div class="d-flex align-items-center mb-2" style="gap: 0.75rem;">
          {% if project.logo %}
            <img src="{{ project.logo | relative_url }}" alt="" style="width: 40px; height: 40px; object-fit: contain; border-radius: 8px; flex: 0 0 40px;" />
          {% endif %}
          <h2 class="card-title m-0" style="font-size: 1.15rem; line-height: 1.3;">{{ project.title }}</h2>
        </div>
        <p class="card-text m-0" style="font-size: 0.9rem; line-height: 1.45;">{{ project.description }}</p>
      </div>
    </div>
  </a>
</div>
